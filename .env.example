# Copy to .env.local for local development. In GitHub, add these as
# repository *variables* (Settings > Secrets and variables > Actions > Variables).
# Firebase web config values are not secrets (security comes from firestore.rules),
# but keeping them out of the source makes the repo reusable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true to use local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
